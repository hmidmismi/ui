{
  "name": "@hmidmismi/ui",
  "version": "0.1.0",
  "description": "Shared component library — Park UI/Ark UI primitives + Panda CSS",
  "type": "module",
  "author": "jasloe",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styled-system/styles.css"
  },
  "scripts": {
    "postinstall": "pnpm run panda:build && pnpm run build",
    "build": "tsc -b",
    "panda:prepare": "panda codegen",
    "panda:watch": "panda codegen --watch",
    "panda:css": "panda cssgen --watch",
    "panda:build": "NODE_ENV=production panda codegen && NODE_ENV=production panda cssgen",
    "dev": "concurrently \"pnpm panda:watch\" \"pnpm panda:css\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo styled-system dist"
  },
  "dependencies": {
    "@ark-ui/react": "^5.38.2",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@chorusworks/tsconfig": "workspace:*",
    "@pandacss/dev": "^1.12.0",
    "@types/react": "^19.2.14",
    "concurrently": "^9.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
