{
  "name": "@hmidmismi/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design system: Panda preset, Park UI/Ark UI components and variants",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset/index.ts",
    "./forms": "./src/modules/forms.ts",
    "./admin": "./src/modules/admin.ts",
    "./catalog": "./src/modules/catalog.ts",
    "./theme": "./src/theme/index.ts",
    "./design": "./src/design/index.ts",
    "./styles.css": "./styled-system/styles.css",
    "./text": "./src/text/index.ts"
  },
  "scripts": {
    "codegen": "panda codegen --clean && panda cssgen",
    "postinstall": "pnpm codegen",
    "dev": "concurrently -k \"panda codegen --watch\" \"panda cssgen --watch\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.components.json",
    "clean": "rm -rf styled-system .turbo node_modules",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "test:browser": "pnpm codegen && vitest run --config vitest.browser.config.ts",
    "check:baseline": "node src/grid/check/check-baseline.mjs",
    "check:spacing": "node src/grid/check/check-spacing.mjs",
    "check:baseline:firefox": "node src/grid/check/check-baseline-firefox.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json -A no-console --ignore-pattern styled-system ."
  },
  "dependencies": {
    "@ark-ui/react": "^5.40.1",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.5.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.79.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hmidmismi/tsconfig": "workspace:*",
    "@pandacss/dev": "^2.6.0",
    "@pandacss/preset-base": "^2.6.0",
    "@pandacss/preset-panda": "^2.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "author": "jasloe",
  "license": "UNLICENSED"
}
