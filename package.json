{
  "name": "@baikikai/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design system: Panda preset, Park UI/Ark UI components and variants",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset/index.ts",
    "./styles.css": "./styled-system/styles.css"
  },
  "scripts": {
    "codegen": "panda codegen && panda cssgen",
    "dev": "concurrently -k \"panda codegen --watch\" \"panda cssgen --watch\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf styled-system .turbo node_modules"
  },
  "dependencies": {
    "@ark-ui/react": "^5.38.2",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.3.0",
    "lucide-react": "^1.14.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hmidmismi/tsconfig": "workspace:*",
    "@pandacss/dev": "^1.12.0",
    "@pandacss/preset-base": "^1.12.0",
    "@pandacss/preset-panda": "^1.12.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "vitest": "^2.1.9"
  },
  "author": "jasloe",
  "license": "UNLICENSED"
}
